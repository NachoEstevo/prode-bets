{
  "manifest_version": 3,
  "name": "Prode Bets",
  "version": "0.1.0",
  "description": "Prode-style pre-match betting drops, friends leaderboard context, and a future lane for Polymarket trading.",
  "permissions": [
    "activeTab",
    "alarms",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://site.api.espn.com/*",
    "https://gamma-api.polymarket.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "451903365601-r1ob21j89148demr8ulsi1fdh6v40ukn.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Prode Bets"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/matchday-overlay.js",
        "src/content/score-alert-overlay.js",
        "src/content/twitter-match-injector.js"
      ],
      "css": [
        "src/content/matchday-overlay.css",
        "src/content/matchday-player.css",
        "src/content/matchday-refined.css",
        "src/content/matchday-room.css",
        "src/content/score-alert-overlay.css",
        "src/content/twitter-match-injector.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/sample-match.json",
        "src/assets/flags/argentina.svg",
        "src/assets/flags/brazil.svg",
        "src/assets/flags/ireland.svg",
        "src/assets/flags/qatar.svg",
        "src/assets/mascot/picanthe-kickups.svg",
        "src/assets/chili/picanthe-idle-kickups-sheet.png",
        "src/calendar/calendar-panel.js",
        "src/calendar/ics-calendar.js",
        "src/calendar/world-cup-calendar.js",
        "src/config/supabase.js",
        "src/social/room-state.js",
        "src/social/room-client.js",
        "src/social/supabase-room-client.js",
        "src/social/room-panel.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "key": ""
}
